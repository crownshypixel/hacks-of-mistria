{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/src/**/*", "src/preload/**/*", "src/main/ipc.ts", "src/schema/**/*"],
  "compilerOptions": {
    "types": ["vite/client", "node"], // having "node" types is the only way of inferring correct the IPC types
    "composite": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/renderer/src/*"],
      "shared/*": ["src/shared/*"],
      "main/*": ["src/main/*"],
      "schema/*": ["src/schema/*"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
