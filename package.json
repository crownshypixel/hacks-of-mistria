{
  "name": "hacks-of-mistria",
  "version": "0.9.6",
  "description": "A tool to edit your save files in Fields of Mistria",
  "main": "./out/main/index.js",
  "author": "crownshypixel",
  "scripts": {
    "prepare": "husky || true",
    "dev": "set NODE_ENV=development && electron-vite dev",
    "dev:watch": "set NODE_ENV=development && electron-vite dev -w",
    "measure-unpacking": "node ./scripts/measure-unpacking.js",
    "update-ids": "node ./scripts/update-ids.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build": "set NODE_ENV=production && electron-vite build && electron-builder --win",
    "chakra": "chakra"
  },
  "husky": {},
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npx prettier --write --config ./.prettierrc.yaml"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.13.3",
    "@tanstack/react-query": "^5.61.3",
    "@tanstack/react-query-devtools": "^5.61.3",
    "electron-context-menu": "^4.0.5",
    "immer": "^10.1.1",
    "interprocess": "^0.2.6",
    "next-themes": "^0.4.6",
    "p-limit": "^6.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-icons": "^5.5.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.13.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.3.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.10"
  }
}
